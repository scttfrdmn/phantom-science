# Makefile for Streaming VCF Processing Architecture
# Handles streaming genomic variant processing with authenticity analysis

# Variables
VCF_SRC_DIR = internal/genomics/vcf
STREAM_VCF_CMD = cmd/stream_vcf
TEST_DATA_DIR = testdata/vcf

# Build targets
.PHONY: streaming-build streaming-test streaming-benchmark streaming-clean help-streaming

# Default target
streaming: streaming-build

# Build streaming VCF processor
streaming-build:
	@echo "🔨 Building streaming VCF processor..."
	@go build -o bin/stream_vcf $(STREAM_VCF_CMD)
	@echo "✅ Streaming VCF processor built: bin/stream_vcf"

# Test streaming VCF functionality
streaming-test:
	@echo "🧪 Testing streaming VCF functionality..."
	@go test -v $(VCF_SRC_DIR)/... -run TestStream
	@echo "✅ Streaming VCF tests completed"

# Test with race detection
streaming-test-race:
	@echo "🧪 Testing streaming VCF with race detection..."
	@go test -race -v $(VCF_SRC_DIR)/... -run TestStream
	@echo "✅ Race condition tests completed"

# Create test VCF data
streaming-test-data:
	@echo "📊 Creating test VCF data..."
	@mkdir -p $(TEST_DATA_DIR)
	@echo "##fileformat=VCFv4.2" > $(TEST_DATA_DIR)/test.vcf
	@echo "##INFO=<ID=DP,Number=1,Type=Integer,Description=\"Read Depth\">" >> $(TEST_DATA_DIR)/test.vcf
	@echo "##FORMAT=<ID=GT,Number=1,Type=String,Description=\"Genotype\">" >> $(TEST_DATA_DIR)/test.vcf
	@echo "#CHROM	POS	ID	REF	ALT	QUAL	FILTER	INFO	FORMAT	SAMPLE1" >> $(TEST_DATA_DIR)/test.vcf
	@echo "chr1	100	.	A	T	30	PASS	DP=10	GT	0/1" >> $(TEST_DATA_DIR)/test.vcf
	@echo "chr1	200	.	G	C	35	PASS	DP=15	GT	1/1" >> $(TEST_DATA_DIR)/test.vcf
	@echo "chr1	300	.	T	A	40	PASS	DP=20	GT	0/0" >> $(TEST_DATA_DIR)/test.vcf
	@echo "✅ Test VCF data created: $(TEST_DATA_DIR)/test.vcf"

# Run streaming VCF processing on test data
streaming-test-run: streaming-build streaming-test-data
	@echo "🔄 Running streaming VCF processing on test data..."
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -verbose -progress
	@echo "✅ Test run completed"

# Run streaming benchmark with various parameters
streaming-benchmark: streaming-build streaming-test-data
	@echo "📊 Running streaming VCF benchmarks..."
	@echo ""
	@echo "Standard processing:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -k 6 -verbose
	@echo ""
	@echo "GPU-accelerated processing:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -k 8 -gpu -verbose
	@echo ""
	@echo "ML-enhanced processing:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -k 8 -ml -verbose
	@echo ""

# Performance tests with different configurations
streaming-perf-buffer: streaming-build streaming-test-data
	@echo "📈 Testing different buffer sizes..."
	@for buffer in 4096 16384 65536 262144; do \
		echo "Buffer size: $$buffer bytes"; \
		./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -buffer $$buffer -k 8; \
		echo ""; \
	done

streaming-perf-workers: streaming-build streaming-test-data
	@echo "👷 Testing different worker counts..."
	@for workers in 1 2 4 8 16; do \
		echo "Workers: $$workers"; \
		./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -workers $$workers -k 8; \
		echo ""; \
	done

streaming-perf-kmer: streaming-build streaming-test-data
	@echo "🧬 Testing different k-mer sizes..."
	@for k in 4 6 8 10 12; do \
		echo "K-mer size: $$k"; \
		./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -k $$k -verbose; \
		echo ""; \
	done

# Memory usage tests
streaming-memory-test: streaming-build streaming-test-data
	@echo "💾 Testing memory usage with different cache sizes..."
	@for cache in 1048576 10485760 104857600 1073741824; do \
		cache_mb=$$((cache / 1048576)); \
		echo "Cache size: $${cache_mb}MB"; \
		./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -cache $$cache -k 8 -verbose; \
		echo ""; \
	done

# Create larger test VCF for stress testing
streaming-stress-data:
	@echo "📊 Creating large test VCF data for stress testing..."
	@mkdir -p $(TEST_DATA_DIR)
	@echo "##fileformat=VCFv4.2" > $(TEST_DATA_DIR)/large_test.vcf
	@echo "##INFO=<ID=DP,Number=1,Type=Integer,Description=\"Read Depth\">" >> $(TEST_DATA_DIR)/large_test.vcf
	@echo "##INFO=<ID=POP,Number=1,Type=String,Description=\"Population\">" >> $(TEST_DATA_DIR)/large_test.vcf
	@echo "##FORMAT=<ID=GT,Number=1,Type=String,Description=\"Genotype\">" >> $(TEST_DATA_DIR)/large_test.vcf
	@echo "#CHROM	POS	ID	REF	ALT	QUAL	FILTER	INFO	FORMAT	SAMPLE1	SAMPLE2	SAMPLE3" >> $(TEST_DATA_DIR)/large_test.vcf
	@for i in $$(seq 1 10000); do \
		pos=$$((i * 100)); \
		qual=$$((30 + i % 40)); \
		dp=$$((10 + i % 20)); \
		pop="POP$$((i % 3 + 1))"; \
		ref=$$(echo "ATGC" | cut -c$$((i % 4 + 1))); \
		alt=$$(echo "CGAT" | cut -c$$((i % 4 + 1))); \
		echo "chr$$((i % 22 + 1))	$$pos	.	$$ref	$$alt	$$qual	PASS	DP=$$dp;POP=$$pop	GT	0/1	1/1	0/0" >> $(TEST_DATA_DIR)/large_test.vcf; \
	done
	@echo "✅ Large test VCF created: $(TEST_DATA_DIR)/large_test.vcf (10,000 variants)"

# Stress test with large VCF
streaming-stress-test: streaming-build streaming-stress-data
	@echo "🔥 Running stress test with large VCF..."
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -gpu -workers 8 -progress -verbose
	@echo "✅ Stress test completed"

# Authenticity analysis tests
streaming-authenticity-test: streaming-build streaming-stress-data
	@echo "🎯 Testing authenticity analysis..."
	@echo ""
	@echo "Standard authenticity analysis:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -target 50.3 -tolerance 2.1 -verbose
	@echo ""
	@echo "Multi-population analysis:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -populations "POP1,POP2,POP3" -verbose
	@echo ""

# GPU acceleration tests
streaming-gpu-test: streaming-build streaming-test-data
	@echo "🚀 Testing GPU acceleration..."
	@if command -v nvidia-smi >/dev/null 2>&1; then \
		echo "NVIDIA GPU detected, testing CUDA acceleration:"; \
		./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -gpu -k 8 -verbose; \
	elif [ "$$(uname)" = "Darwin" ]; then \
		echo "macOS detected, testing Metal acceleration:"; \
		./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -gpu -k 8 -verbose; \
	else \
		echo "No GPU acceleration available, skipping GPU tests"; \
	fi

# Integration test with memory optimization
streaming-memory-integration: streaming-build streaming-stress-data
	@echo "🗜️  Testing memory optimization integration..."
	@echo ""
	@echo "Hash map vs Packed array comparison:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -verbose
	@echo ""
	@echo "With GPU + Memory optimization:"
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -gpu -verbose
	@echo ""

# Output format tests
streaming-output-test: streaming-build streaming-test-data
	@echo "📄 Testing output formats..."
	@mkdir -p $(TEST_DATA_DIR)/output
	@./bin/stream_vcf -input $(TEST_DATA_DIR)/test.vcf -output $(TEST_DATA_DIR)/output/results.json -k 8 -verbose
	@echo "Output file created:"
	@ls -la $(TEST_DATA_DIR)/output/results.json
	@echo "Output content:"
	@cat $(TEST_DATA_DIR)/output/results.json
	@echo ""

# Comprehensive streaming test suite
streaming-test-comprehensive: streaming-test streaming-test-race streaming-test-run streaming-benchmark streaming-memory-test streaming-authenticity-test
	@echo "🎉 Comprehensive streaming test suite completed!"

# Performance comparison with different approaches
streaming-performance-comparison: streaming-build streaming-stress-data
	@echo "⚖️  Performance comparison across configurations..."
	@echo ""
	@echo "CPU only:"
	@time ./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -workers 1
	@echo ""
	@echo "CPU multi-threaded:"
	@time ./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -workers 8
	@echo ""
	@echo "GPU accelerated:"
	@time ./bin/stream_vcf -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -gpu -workers 4
	@echo ""

# Clean streaming artifacts
streaming-clean:
	@echo "🧹 Cleaning streaming artifacts..."
	@rm -f bin/stream_vcf
	@rm -rf $(TEST_DATA_DIR)
	@echo "✅ Streaming artifacts cleaned"

# Validate VCF file format
streaming-validate: streaming-build
	@echo "✅ Validating VCF file format..."
	@if [ -z "$(VCF_FILE)" ]; then \
		echo "Usage: make streaming-validate VCF_FILE=path/to/file.vcf"; \
	else \
		./bin/stream_vcf -input $(VCF_FILE) -k 6 -verbose; \
	fi

# Profile streaming performance
streaming-profile: streaming-build streaming-stress-data
	@echo "📊 Profiling streaming performance..."
	@go build -o bin/stream_vcf_profile $(STREAM_VCF_CMD)
	@./bin/stream_vcf_profile -input $(TEST_DATA_DIR)/large_test.vcf -k 8 -cpuprofile /tmp/stream_cpu.prof -memprofile /tmp/stream_mem.prof
	@echo "CPU profile: /tmp/stream_cpu.prof"
	@echo "Memory profile: /tmp/stream_mem.prof"
	@echo "Analyze with: go tool pprof /tmp/stream_cpu.prof"

# All streaming performance tests
streaming-perf-all: streaming-perf-buffer streaming-perf-workers streaming-perf-kmer streaming-memory-test

# Development workflow
streaming-dev: streaming-build streaming-test streaming-test-run
	@echo "🚀 Streaming VCF development cycle complete"

# Production validation
streaming-production-validate: streaming-test-comprehensive streaming-stress-test streaming-performance-comparison
	@echo "✅ Streaming VCF production validation complete"

# Help for streaming targets
help-streaming:
	@echo "🌊 Streaming VCF Processing Targets:"
	@echo ""
	@echo "  streaming-build          - Build streaming VCF processor"
	@echo "  streaming-test           - Test streaming functionality"
	@echo "  streaming-test-run       - Run on test data"
	@echo "  streaming-benchmark      - Run performance benchmarks"
	@echo ""
	@echo "  streaming-perf-*         - Performance tests (buffer/workers/kmer)"
	@echo "  streaming-memory-test    - Memory usage tests"
	@echo "  streaming-stress-test    - Large dataset stress test"
	@echo "  streaming-gpu-test       - GPU acceleration tests"
	@echo ""
	@echo "  streaming-authenticity-test - Authenticity analysis tests"
	@echo "  streaming-output-test       - Output format tests"
	@echo "  streaming-validate          - Validate VCF file (set VCF_FILE=path)"
	@echo ""
	@echo "  streaming-test-comprehensive - Complete test suite"
	@echo "  streaming-production-validate - Production validation"
	@echo ""
	@echo "Streaming VCF processing provides:"
	@echo "  - Memory-efficient processing of unlimited VCF size"
	@echo "  - GPU-accelerated k-mer analysis with packed arrays"
	@echo "  - Statistical authenticity validation (~50.3% target)"
	@echo "  - Multi-population genomic analysis"
	@echo "  - Real-time progress monitoring and caching"

# Example usage scenarios
streaming-examples:
	@echo "💡 Streaming VCF Usage Examples:"
	@echo ""
	@echo "# Basic VCF processing:"
	@echo "./bin/stream_vcf -input variants.vcf -k 8 -verbose"
	@echo ""
	@echo "# GPU-accelerated authenticity analysis:"
	@echo "./bin/stream_vcf -input variants.vcf -k 8 -gpu -target 50.3 -tolerance 2.1"
	@echo ""
	@echo "# Multi-population analysis with output:"
	@echo "./bin/stream_vcf -input variants.vcf -populations \"EUR,AFR,ASN\" -output results.json"
	@echo ""
	@echo "# High-performance processing:"
	@echo "./bin/stream_vcf -input large.vcf -k 8 -gpu -workers 8 -cache 2147483648 -progress"
	@echo ""
	@echo "# Memory-optimized processing:"
	@echo "./bin/stream_vcf -input huge.vcf -k 10 -buffer 1048576 -cache 536870912"