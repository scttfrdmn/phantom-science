# Developer benchmarks for reference.ReferenceManager (lazy region loading,
# region and k-mer-profile caching). Drives cmd/experiments/benchmark_reference,
# which is not part of the CLI.
#
# Usage: make -f Makefile.reference <target> [REFERENCE=genome.fa]
# Without REFERENCE the benchmark generates a temporary random FASTA
# (5 x 10 MiB) and deletes it afterwards.

REFERENCE_PKG       = ./internal/genomics/reference
BENCHMARK_REFERENCE = ./cmd/experiments/benchmark_reference
BIN                 = bin/benchmark_reference
REFERENCE          ?=
REF_FLAG            = $(if $(REFERENCE),-reference $(REFERENCE))
RUN                 = ./$(BIN) $(REF_FLAG)

.PHONY: reference reference-benchmark reference-bench-basic \
	reference-bench-comprehensive reference-cache-scaling reference-prefetch-test \
	reference-kmer-scaling reference-region-scaling reference-test \
	reference-test-race reference-stress-test reference-concurrent-test \
	reference-perf-all reference-stress-all reference-test-complete reference-dev \
	reference-clean help-reference reference-examples

reference: reference-benchmark

reference-benchmark:
	@mkdir -p bin
	go build -o $(BIN) $(BENCHMARK_REFERENCE)

reference-bench-basic: reference-benchmark
	$(RUN) -benchmark cache -regions 500 -verbose
	$(RUN) -benchmark kmer -k 8 -regions 200 -verbose

reference-bench-comprehensive: reference-benchmark
	$(RUN) -benchmark all -regions 1000 -k 8 -verbose

# 1000 regions of 10 kb need about 10 MiB of cache; below that the warm pass
# misses.
reference-cache-scaling: reference-benchmark
	@for mb in 1 4 8 16 64; do \
		echo "cache=$${mb}MiB"; \
		$(RUN) -benchmark cache -cache $$((mb * 1024 * 1024)) -regions 1000 || exit 1; \
	done

reference-prefetch-test: reference-benchmark
	$(RUN) -benchmark prefetch -regions 300 -verbose
	$(RUN) -benchmark prefetch -prefetch -regions 300 -verbose

reference-kmer-scaling: reference-benchmark
	@for k in 4 6 8 10 12; do \
		echo "k=$$k"; \
		$(RUN) -benchmark kmer -k $$k -regions 200 || exit 1; \
	done

reference-region-scaling: reference-benchmark
	@for kb in 1 5 10 50 100; do \
		echo "region=$${kb}KiB"; \
		$(RUN) -benchmark cache -region-size $$((kb * 1024)) -regions 200 || exit 1; \
	done

reference-test:
	go test -v $(REFERENCE_PKG) -run 'TestLazy'
	go test -v $(BENCHMARK_REFERENCE)

reference-test-race:
	go test -race -v $(REFERENCE_PKG) -run 'TestLazy'
	go test -race $(BENCHMARK_REFERENCE)

# A generated 5 x 50 MiB reference with a 4 GiB cache.
reference-stress-test: reference-benchmark
	./$(BIN) -gen-length 52428800 -benchmark all -regions 2000 -cache 4294967296 -verbose

# Three benchmark processes reading the same reference at once.
reference-concurrent-test: reference-benchmark
	$(RUN) -benchmark cache -regions 200 & p1=$$!; \
	$(RUN) -benchmark kmer -k 8 -regions 200 & p2=$$!; \
	$(RUN) -benchmark prefetch -regions 200 & p3=$$!; \
	wait $$p1 && wait $$p2 && wait $$p3

reference-perf-all: reference-cache-scaling reference-prefetch-test reference-kmer-scaling reference-region-scaling

reference-stress-all: reference-stress-test reference-concurrent-test

reference-test-complete: reference-test reference-test-race reference-bench-comprehensive

reference-dev: reference-test reference-bench-basic

reference-clean:
	rm -f $(BIN)

help-reference:
	@echo "Reference manager benchmarks (make -f Makefile.reference <target> [REFERENCE=genome.fa]):"
	@echo "  reference-benchmark           build $(BIN)"
	@echo "  reference-bench-basic         cache and k-mer benchmarks"
	@echo "  reference-bench-comprehensive all benchmarks"
	@echo "  reference-cache-scaling       cache sizes 1-64 MiB"
	@echo "  reference-prefetch-test       PrefetchRegions without and with read-ahead"
	@echo "  reference-kmer-scaling        k=4..12"
	@echo "  reference-region-scaling      regions of 1-100 KiB"
	@echo "  reference-test, reference-test-race  lazy-loader and benchmark tests"
	@echo "  reference-stress-test         5 x 50 MiB generated reference"
	@echo "  reference-concurrent-test     three benchmark processes at once"
	@echo "  reference-perf-all, reference-stress-all, reference-test-complete, reference-dev"
	@echo "  reference-clean               remove $(BIN)"
	@echo "  reference-examples            example command lines"

reference-examples:
	@echo "./$(BIN) -benchmark cache -regions 500"
	@echo "./$(BIN) -reference genome.fa -benchmark kmer -k 8 -regions 200"
	@echo "./$(BIN) -benchmark all -regions 1000 -verbose"
	@echo "./$(BIN) -benchmark prefetch -prefetch -prefetch-window 5000"
	@echo "./$(BIN) -gen-chroms 2 -gen-length 1000000 -seed 3 -benchmark cache"
