# Makefile for NVIDIA CUDA GPU acceleration support
# Handles CUDA kernel compilation and integration

# Variables
CUDA_SRC_DIR = internal/genomics/acceleration/cuda
CUDA_KERNELS = $(CUDA_SRC_DIR)/kmer_kernels.cu
CUDA_PTX = $(CUDA_SRC_DIR)/kmer_kernels.ptx
CUDA_BRIDGE_CPP = $(CUDA_SRC_DIR)/cuda_bridge.cpp
CUDA_BRIDGE_H = $(CUDA_SRC_DIR)/cuda_bridge.h

# CUDA compiler and flags
NVCC := $(shell which nvcc)
CUDA_ARCH_FLAGS = -gencode arch=compute_50,code=sm_50 \
                  -gencode arch=compute_60,code=sm_60 \
                  -gencode arch=compute_70,code=sm_70 \
                  -gencode arch=compute_75,code=sm_75 \
                  -gencode arch=compute_80,code=sm_80 \
                  -gencode arch=compute_86,code=sm_86 \
                  -gencode arch=compute_89,code=sm_89
NVCC_FLAGS = -O3 -use_fast_math --ptx $(CUDA_ARCH_FLAGS)

# Check if CUDA is available
HAS_CUDA := $(shell command -v nvcc 2> /dev/null)
HAS_NVIDIA_SMI := $(shell command -v nvidia-smi 2> /dev/null)

.PHONY: cuda-check cuda-compile cuda-clean cuda-install gpu-benchmark-cuda help-cuda

# Default target
cuda: cuda-check cuda-compile

# Check CUDA environment
cuda-check:
ifndef HAS_CUDA
	@echo "❌ CUDA Toolkit not found - please install NVIDIA CUDA Toolkit"
	@echo "   Download from: https://developer.nvidia.com/cuda-toolkit"
	@exit 1
endif
ifndef HAS_NVIDIA_SMI
	@echo "❌ NVIDIA drivers not found - please install NVIDIA drivers"
	@echo "   Download from: https://www.nvidia.com/drivers"
	@exit 1
endif
	@echo "✅ CUDA development environment available"
	@nvcc --version | head -4
	@echo ""
	@echo "📊 Available GPUs:"
	@nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv,noheader,nounits | \
		awk 'BEGIN{print "   GPU | Memory | Compute"} {printf "   %s | %s MB | %s\n", $$1, $$2, $$3}'

# Compile CUDA kernels
cuda-compile: cuda-check
	@echo "🔨 Compiling CUDA kernels..."
	@echo "   Source: $(CUDA_KERNELS)"
	@echo "   Output: $(CUDA_PTX)"
	@mkdir -p $(dir $(CUDA_PTX))
	@$(NVCC) $(NVCC_FLAGS) -o $(CUDA_PTX) $(CUDA_KERNELS)
	@echo "✅ CUDA kernels compiled successfully"
	@ls -lh $(CUDA_PTX)

# Clean CUDA build artifacts
cuda-clean:
	@echo "🧹 Cleaning CUDA build artifacts..."
	@rm -f $(CUDA_PTX) $(CUDA_SRC_DIR)/*.cubin $(CUDA_SRC_DIR)/*.fatbin
	@echo "✅ CUDA artifacts cleaned"

# Install CUDA libraries (check dependencies)
cuda-install: cuda-compile
	@echo "📦 Checking CUDA runtime dependencies..."
	@if [ -f "/usr/local/cuda/lib64/libcudart.so" ]; then \
		echo "✅ CUDA runtime library found"; \
	elif [ -f "/usr/lib/x86_64-linux-gnu/libcudart.so" ]; then \
		echo "✅ CUDA runtime library found (system)"; \
	else \
		echo "⚠️  CUDA runtime library not found in standard locations"; \
		echo "   Make sure LD_LIBRARY_PATH includes CUDA libraries"; \
	fi

# Build GPU benchmark tool with CUDA support
gpu-benchmark-cuda: cuda-compile
	@echo "🚀 Building CUDA GPU benchmark tool..."
	@CGO_ENABLED=1 go build -tags cuda -o bin/benchmark_gpu_cuda ./cmd/benchmark_gpu
	@echo "✅ CUDA GPU benchmark tool built: bin/benchmark_gpu_cuda"

# Run comprehensive CUDA GPU benchmarks
cuda-bench-run: gpu-benchmark-cuda
	@echo "🧪 Running comprehensive CUDA GPU benchmarks..."
	@./bin/benchmark_gpu_cuda -k 6 -sequences 10000 -length 1000 -verbose
	@echo ""
	@./bin/benchmark_gpu_cuda -k 8 -sequences 20000 -length 1000 -verbose
	@echo ""
	@./bin/benchmark_gpu_cuda -k 10 -sequences 10000 -length 2000 -verbose

# Quick CUDA GPU performance test
cuda-test: gpu-benchmark-cuda
	@echo "⚡ Quick CUDA GPU performance test..."
	@./bin/benchmark_gpu_cuda -k 6 -sequences 5000 -length 1000

# Build with CUDA support
build-cuda: cuda-compile
	@echo "🔨 Building phantom-science with CUDA GPU support..."
	@CGO_ENABLED=1 go build -tags cuda -ldflags="-lcudart -lcuda" -o phantom-science-cuda .
	@echo "✅ Built with CUDA GPU acceleration support"

# Test CUDA integration
test-cuda: cuda-compile
	@echo "🧪 Testing CUDA GPU integration..."
	@CGO_ENABLED=1 go test -tags cuda ./internal/genomics/acceleration/cuda/... -v
	@echo "✅ CUDA integration tests completed"

# Profile CUDA GPU performance
profile-cuda: gpu-benchmark-cuda
	@echo "📊 Profiling CUDA GPU performance..."
	@echo "Use NVIDIA Nsight Systems or nvprof:"
	@echo "  nsys profile --stats=true ./bin/benchmark_gpu_cuda -k 8 -sequences 10000 -length 1000"
	@echo "  nvprof ./bin/benchmark_gpu_cuda -k 8 -sequences 10000 -length 1000"

# Generate CUDA build configuration
cuda-config:
	@echo "⚙️  Generating CUDA build configuration..."
	@go run $(CUDA_SRC_DIR)/build.go > cuda-build-config.sh
	@chmod +x cuda-build-config.sh
	@echo "✅ CUDA build configuration generated: cuda-build-config.sh"

# Help for CUDA-specific targets
help-cuda:
	@echo "🚀 NVIDIA CUDA GPU Acceleration Targets:"
	@echo ""
	@echo "  cuda-check      - Check CUDA development environment"
	@echo "  cuda-compile    - Compile CUDA compute kernels"
	@echo "  cuda-clean      - Clean compiled CUDA artifacts"
	@echo "  cuda-install    - Check CUDA runtime dependencies"
	@echo ""
	@echo "  gpu-benchmark-cuda - Build CUDA GPU benchmark tool"
	@echo "  cuda-bench-run  - Run comprehensive CUDA GPU benchmarks"
	@echo "  cuda-test       - Quick CUDA GPU performance test"
	@echo ""
	@echo "  build-cuda      - Build phantom-science with CUDA support"
	@echo "  test-cuda       - Run CUDA integration tests"
	@echo "  profile-cuda    - Instructions for CUDA GPU profiling"
	@echo "  cuda-config     - Generate CUDA build configuration"
	@echo ""
	@echo "CUDA GPU acceleration requires:"
	@echo "  - NVIDIA GPU with compute capability 5.0+ (Maxwell or newer)"
	@echo "  - NVIDIA CUDA Toolkit 11.0+ or 12.0+"
	@echo "  - NVIDIA drivers (compatible with CUDA version)"
	@echo "  - CGO enabled for CUDA library integration"

# Performance targets for different k-mer sizes (CUDA optimized)
cuda-perf-k4: gpu-benchmark-cuda
	@./bin/benchmark_gpu_cuda -k 4 -sequences 50000 -length 500

cuda-perf-k6: gpu-benchmark-cuda
	@./bin/benchmark_gpu_cuda -k 6 -sequences 30000 -length 1000

cuda-perf-k8: gpu-benchmark-cuda
	@./bin/benchmark_gpu_cuda -k 8 -sequences 20000 -length 1500

cuda-perf-k10: gpu-benchmark-cuda
	@./bin/benchmark_gpu_cuda -k 10 -sequences 10000 -length 3000

cuda-perf-k12: gpu-benchmark-cuda
	@./bin/benchmark_gpu_cuda -k 12 -sequences 5000 -length 5000

cuda-perf-k14: gpu-benchmark-cuda
	@./bin/benchmark_gpu_cuda -k 14 -sequences 2000 -length 10000

# Memory and throughput stress tests
cuda-perf-memory: gpu-benchmark-cuda
	@echo "🧠 CUDA GPU memory stress test..."
	@./bin/benchmark_gpu_cuda -k 8 -sequences 100000 -length 2000 -verbose

cuda-perf-throughput: gpu-benchmark-cuda
	@echo "🚄 CUDA GPU throughput test..."
	@./bin/benchmark_gpu_cuda -k 6 -sequences 200000 -length 1000 -verbose

# Large dataset tests
cuda-perf-large: gpu-benchmark-cuda
	@echo "📊 CUDA GPU large dataset test..."
	@./bin/benchmark_gpu_cuda -k 8 -sequences 500000 -length 1000 -verbose

# All CUDA performance tests
cuda-perf-all: cuda-perf-k4 cuda-perf-k6 cuda-perf-k8 cuda-perf-k10 cuda-perf-k12 cuda-perf-k14 cuda-perf-memory cuda-perf-throughput

# Docker support for CUDA
cuda-docker-build:
	@echo "🐳 Building CUDA Docker image..."
	@docker build -f Dockerfile.cuda -t phantom-science-cuda .

cuda-docker-run:
	@echo "🐳 Running CUDA Docker container..."
	@docker run --gpus all -it phantom-science-cuda

# Clean everything (including generated configs)
cuda-clean-all: cuda-clean
	@rm -f cuda-build-config.sh bin/benchmark_gpu_cuda phantom-science-cuda