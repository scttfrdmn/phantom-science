package genomics

import (
	"os"
	"path/filepath"
	"testing"
	"github.com/scttfrdmn/phantom-science/pkg/types"
)

// BenchmarkFASTQGeneration benchmarks FASTQ file generation performance
func BenchmarkFASTQGeneration(b *testing.B) {
	tmpDir := b.TempDir()
	
	config := types.SequencerConfig{
		SampleName:    "Benchmark_Sample",
		Lane:          1,
		OutputDir:     tmpDir,
		ReadLength:    150,
		ReadsPerBatch: 1000,
		BatchInterval: "1s",
		TotalBatches:  1,
		PairedEnd:     false,
		BaseQuality:   30,
		QualityDecay:  0.1,
	}

	engine := NewEngine(config)
	
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		filename := filepath.Join(tmpDir, "benchmark_R1_001.fastq")
		err := engine.generateFASTQFile(filename, 1, 1)
		if err != nil {
			b.Fatalf("Failed to generate FASTQ file: %v", err)
		}
		// Clean up for next iteration
		os.Remove(filename)
	}
}

// BenchmarkFASTQGenerationPairedEnd benchmarks paired-end FASTQ generation
func BenchmarkFASTQGenerationPairedEnd(b *testing.B) {
	tmpDir := b.TempDir()
	
	config := types.SequencerConfig{
		SampleName:    "Benchmark_Paired",
		Lane:          1,
		OutputDir:     tmpDir,
		ReadLength:    150,
		ReadsPerBatch: 500,
		BatchInterval: "1s",
		TotalBatches:  1,
		PairedEnd:     true,
		BaseQuality:   35,
		QualityDecay:  0.05,
	}

	engine := NewEngine(config)
	
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		err := engine.Generate()
		if err != nil {
			b.Fatalf("Failed to generate paired-end FASTQ files: %v", err)
		}
		// Clean up output directory for next iteration
		os.RemoveAll(tmpDir)
		os.MkdirAll(tmpDir, 0755)
	}
}

