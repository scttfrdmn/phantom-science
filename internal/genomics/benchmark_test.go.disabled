// BenchmarkSequenceGeneration benchmarks just the sequence generation part
func BenchmarkSequenceGeneration(b *testing.B) {
	config := types.SequencerConfig{
		ReadLength: 150,
	}
	
	engine := NewEngine(config)
	
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		sequence := engine.generateSequence()
		if len(sequence) != config.ReadLength {
			b.Fatalf("Expected sequence length %d, got %d", config.ReadLength, len(sequence))
		}
	}
}

// BenchmarkQualityGeneration benchmarks quality string generation
func BenchmarkQualityGeneration(b *testing.B) {
	config := types.SequencerConfig{
		ReadLength:   150,
		BaseQuality:  30,
		QualityDecay: 0.1,
	}
	
	engine := NewEngine(config)
	
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		quality := engine.generateQualityString()
		if len(quality) != config.ReadLength {
			b.Fatalf("Expected quality length %d, got %d", config.ReadLength, len(quality))
		}
	}
}

// Benchmark memory allocation patterns
func BenchmarkMemoryAllocation(b *testing.B) {
	config := types.SequencerConfig{
		ReadLength:   150,
		ReadsPerBatch: 1000,
		BaseQuality:  30,
		QualityDecay: 0.1,
	}
	
	engine := NewEngine(config)
	
	b.ResetTimer()
	b.ReportAllocs()
	
	for i := 0; i < b.N; i++ {
		sequence := engine.generateSequence()
		quality := engine.generateQualityString()
		
		// Simulate FASTQ record creation
		_ = "@read_" + string(rune(i)) + "\n" + sequence + "\n+\n" + quality + "\n"
	}
}