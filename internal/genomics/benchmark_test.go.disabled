	tmpDir := b.TempDir()
	
	config := types.SequencerConfig{
		SampleName:    "Benchmark_LongRead",
		Lane:          1,
		OutputDir:     tmpDir,
		ReadLength:    300, // Long reads
		ReadsPerBatch: 100,
		BatchInterval: "1s",
		TotalBatches:  1,
		PairedEnd:     false,
		BaseQuality:   30,
		QualityDecay:  0.12,
	}

	engine := NewEngine(config)
	
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		filename := filepath.Join(tmpDir, "benchmark_long_R1_001.fastq")
