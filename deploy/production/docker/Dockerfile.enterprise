# Phantom Science Enterprise Container
# Multi-stage build for production deployment

# Stage 1: Rust builder with GPU support
FROM nvidia/cuda:12.9-devel-ubuntu22.04 AS rust-builder

RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build
COPY stegano/ ./stegano/

# Build stegano library with GPU support
WORKDIR /build/stegano
RUN cargo build --release --features gpu

# Stage 2: Go builder
FROM golang:1.21-alpine AS go-builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=rust-builder /build/stegano/target/release/libstegano.so /usr/local/lib/
COPY --from=rust-builder /build/stegano/target/release/libstegano.a /usr/local/lib/

# Build Go application
RUN CGO_ENABLED=1 go build -o phantom-science .

# Stage 3: Production runtime
FROM nvidia/cuda:12.9-runtime-ubuntu22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create service user
RUN useradd -r -s /bin/false phantom-science

# Copy application and libraries
COPY --from=go-builder /build/phantom-science /usr/local/bin/
COPY --from=rust-builder /build/stegano/target/release/libstegano.so /usr/local/lib/

# Set up directories
RUN mkdir -p /opt/phantom-science/{config,data,logs} \
    && chown -R phantom-science:phantom-science /opt/phantom-science

# Copy default configuration
COPY deploy/production/config/ /opt/phantom-science/config/

USER phantom-science
WORKDIR /opt/phantom-science

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD phantom-science health --quick || exit 1

EXPOSE 8080 8443

ENTRYPOINT ["/usr/local/bin/phantom-science"]
CMD ["server", "--config", "/opt/phantom-science/config/enterprise.yaml"]