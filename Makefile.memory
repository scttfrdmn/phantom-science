# Makefile for Memory Optimization - Packed Arrays
# Handles memory-efficient k-mer processing benchmarks and testing

# Variables
MEMORY_SRC_DIR = internal/genomics/authenticity/kmer
BENCHMARK_MEMORY = cmd/benchmark_memory

.PHONY: memory-benchmark memory-test memory-profile memory-clean help-memory

# Default target
memory: memory-benchmark

# Build memory optimization benchmark tool
memory-benchmark:
	@echo "🔨 Building memory optimization benchmark tool..."
	@go build -o bin/benchmark_memory $(BENCHMARK_MEMORY)
	@echo "✅ Memory benchmark tool built: bin/benchmark_memory"

# Run comprehensive memory benchmarks
memory-bench-run: memory-benchmark
	@echo "🧠 Running comprehensive memory optimization benchmarks..."
	@echo ""
	@echo "📊 Quick comparison (k=8):"
	@./bin/benchmark_memory -k 8 -sequences 5000 -length 1000
	@echo ""
	@echo "📈 Memory scaling analysis:"
	@./bin/benchmark_memory -k 10 -sequences 10000 -length 1000 -memory
	@echo ""
	@echo "🎯 Accuracy verification:"
	@./bin/benchmark_memory -k 6 -sequences 1000 -length 1000 -accuracy
	@echo ""

# Run detailed memory analysis
memory-analysis: memory-benchmark
	@echo "🔬 Detailed memory usage analysis..."
	@echo ""
	@echo "Small k-mers (k=4):"
	@./bin/benchmark_memory -k 4 -sequences 10000 -length 500 -verbose
	@echo ""
	@echo "Medium k-mers (k=8):"
	@./bin/benchmark_memory -k 8 -sequences 5000 -length 1000 -verbose
	@echo ""
	@echo "Large k-mers (k=12):"
	@./bin/benchmark_memory -k 12 -sequences 2000 -length 2000 -verbose
	@echo ""

# Test packed array functionality
memory-test:
	@echo "🧪 Testing packed array functionality..."
	@go test -v $(MEMORY_SRC_DIR) -run TestPacked
	@echo "✅ Packed array tests completed"

# Run memory tests with race detection
memory-test-race:
	@echo "🧪 Testing packed arrays with race detection..."
	@go test -race -v $(MEMORY_SRC_DIR) -run TestPacked
	@echo "✅ Race condition tests completed"

# Profile memory usage
memory-profile: memory-benchmark
	@echo "📊 Profiling memory usage..."
	@echo "Hash map memory profile:"
	@go tool pprof -top -alloc_space ./bin/benchmark_memory /tmp/map_profile.prof 2>/dev/null || \
		echo "Run: ./bin/benchmark_memory -map-only -k 8 -sequences 5000 -cpuprofile /tmp/map_profile.prof"
	@echo ""
	@echo "Packed array memory profile:"
	@go tool pprof -top -alloc_space ./bin/benchmark_memory /tmp/packed_profile.prof 2>/dev/null || \
		echo "Run: ./bin/benchmark_memory -packed-only -k 8 -sequences 5000 -cpuprofile /tmp/packed_profile.prof"

# Performance comparison across different k-mer sizes
memory-perf-k4: memory-benchmark
	@./bin/benchmark_memory -k 4 -sequences 20000 -length 500 -verbose

memory-perf-k6: memory-benchmark
	@./bin/benchmark_memory -k 6 -sequences 15000 -length 750 -verbose

memory-perf-k8: memory-benchmark
	@./bin/benchmark_memory -k 8 -sequences 10000 -length 1000 -verbose

memory-perf-k10: memory-benchmark
	@./bin/benchmark_memory -k 10 -sequences 7000 -length 1500 -verbose

memory-perf-k12: memory-benchmark
	@./bin/benchmark_memory -k 12 -sequences 5000 -length 2000 -verbose

memory-perf-k14: memory-benchmark
	@./bin/benchmark_memory -k 14 -sequences 3000 -length 3000 -verbose

# Memory stress tests
memory-stress-small: memory-benchmark
	@echo "🧠 Small k-mer memory stress test..."
	@./bin/benchmark_memory -k 6 -sequences 50000 -length 500 -memory -verbose

memory-stress-medium: memory-benchmark
	@echo "🧠 Medium k-mer memory stress test..."
	@./bin/benchmark_memory -k 8 -sequences 25000 -length 1000 -memory -verbose

memory-stress-large: memory-benchmark
	@echo "🧠 Large k-mer memory stress test..."
	@./bin/benchmark_memory -k 10 -sequences 10000 -length 2000 -memory -verbose

# Accuracy verification tests
memory-accuracy-comprehensive: memory-benchmark
	@echo "🎯 Comprehensive accuracy verification..."
	@for k in 4 6 8 10 12; do \
		echo "Testing k=$$k..."; \
		./bin/benchmark_memory -k $$k -sequences 2000 -length 1000 -accuracy; \
		echo ""; \
	done

# Compare with existing hash map implementation
memory-compare: memory-benchmark
	@echo "⚖️  Comparing memory optimization impact..."
	@echo ""
	@echo "Hash maps only:"
	@./bin/benchmark_memory -k 8 -sequences 5000 -length 1000 -map-only -verbose
	@echo ""
	@echo "Packed arrays only:"
	@./bin/benchmark_memory -k 8 -sequences 5000 -length 1000 -packed-only -verbose
	@echo ""
	@echo "Full comparison:"
	@./bin/benchmark_memory -k 8 -sequences 5000 -length 1000 -verbose

# Build with memory optimization flags
build-memory-optimized:
	@echo "🔨 Building with memory optimization flags..."
	@go build -ldflags="-s -w" -gcflags="-m=2" -o phantom-science-memory-optimized .
	@echo "✅ Built memory-optimized binary: phantom-science-memory-optimized"

# Clean memory benchmark artifacts
memory-clean:
	@echo "🧹 Cleaning memory benchmark artifacts..."
	@rm -f bin/benchmark_memory phantom-science-memory-optimized
	@rm -f /tmp/*_profile.prof
	@echo "✅ Memory artifacts cleaned"

# Test packed array integration with existing code
memory-integration-test:
	@echo "🔗 Testing packed array integration..."
	@go test -v ./internal/genomics/authenticity/kmer/... -run TestPackedIntegration
	@go test -v ./internal/genomics/acceleration/... -run TestPackedGPU
	@echo "✅ Integration tests completed"

# Benchmark different sequence characteristics
memory-bench-characteristics: memory-benchmark
	@echo "🧬 Benchmarking different sequence characteristics..."
	@echo ""
	@echo "Random sequences (high entropy):"
	@./bin/benchmark_memory -k 8 -sequences 5000 -length 1000 -verbose
	@echo ""
	@echo "Repetitive sequences (low entropy):"
	# Would need to add flag for repetitive sequence generation
	@echo "   Note: Add -repetitive flag to benchmark_memory for this test"

# Memory usage over time analysis
memory-time-analysis: memory-benchmark
	@echo "⏱️  Memory usage over time analysis..."
	@echo "Testing increasing dataset sizes:"
	@for seq_count in 1000 2000 5000 10000 20000; do \
		echo "Sequences: $$seq_count"; \
		./bin/benchmark_memory -k 8 -sequences $$seq_count -length 1000 -memory; \
		echo ""; \
	done

# All memory performance tests
memory-perf-all: memory-perf-k4 memory-perf-k6 memory-perf-k8 memory-perf-k10 memory-perf-k12 memory-perf-k14

# All memory stress tests
memory-stress-all: memory-stress-small memory-stress-medium memory-stress-large

# Complete memory optimization test suite
memory-test-complete: memory-test memory-test-race memory-integration-test memory-accuracy-comprehensive
	@echo "🎉 Complete memory optimization test suite passed!"

# Help for memory optimization targets
help-memory:
	@echo "🗜️  Memory Optimization Targets:"
	@echo ""
	@echo "  memory-benchmark    - Build memory optimization benchmark tool"
	@echo "  memory-bench-run    - Run comprehensive memory benchmarks"
	@echo "  memory-analysis     - Detailed memory usage analysis"
	@echo "  memory-test         - Test packed array functionality"
	@echo "  memory-profile      - Profile memory usage patterns"
	@echo ""
	@echo "  memory-perf-k[4-14] - Performance tests for specific k-mer sizes"
	@echo "  memory-stress-*     - Memory stress tests (small/medium/large)"
	@echo "  memory-compare      - Compare hash maps vs packed arrays"
	@echo ""
	@echo "  memory-accuracy-comprehensive - Verify accuracy across k-mer sizes"
	@echo "  memory-integration-test       - Test integration with existing code"
	@echo "  memory-test-complete          - Complete test suite"
	@echo ""
	@echo "Memory optimization provides:"
	@echo "  - 3-5x memory efficiency improvement"
	@echo "  - Packed binary arrays instead of hash maps"
	@echo "  - Better cache locality and GPU memory usage"
	@echo "  - Maintains 100% accuracy with existing implementations"

# Example usage scenarios
memory-examples:
	@echo "💡 Memory Optimization Usage Examples:"
	@echo ""
	@echo "# Quick comparison test:"
	@echo "./bin/benchmark_memory -k 8 -sequences 5000 -length 1000"
	@echo ""
	@echo "# Memory scaling analysis:"
	@echo "./bin/benchmark_memory -k 10 -sequences 10000 -length 1000 -memory"
	@echo ""
	@echo "# Accuracy verification:"
	@echo "./bin/benchmark_memory -k 6 -sequences 1000 -length 1000 -accuracy"
	@echo ""
	@echo "# Hash maps only (baseline):"
	@echo "./bin/benchmark_memory -k 8 -sequences 5000 -map-only -verbose"
	@echo ""
	@echo "# Packed arrays only (optimized):"
	@echo "./bin/benchmark_memory -k 8 -sequences 5000 -packed-only -verbose"

# Development targets
memory-dev: memory-benchmark memory-test memory-bench-run
	@echo "🚀 Memory optimization development cycle complete"

# Production validation
memory-production-validate: memory-test-complete memory-perf-all memory-stress-all
	@echo "✅ Memory optimization production validation complete"