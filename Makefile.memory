# Developer benchmarks for the k-mer counters: hash map (kmer.FrequencyTable)
# against packed array (kmer.PackedFrequencyTable). Drives
# cmd/experiments/benchmark_memory, which is not part of the CLI.
#
# Usage: make -f Makefile.memory <target>     (make -f Makefile.memory help-memory)

KMER_PKG         = ./internal/genomics/authenticity/kmer
BENCHMARK_MEMORY = ./cmd/experiments/benchmark_memory
BIN              = bin/benchmark_memory

.PHONY: memory memory-benchmark memory-bench-run memory-analysis memory-test \
	memory-test-race memory-perf-k4 memory-perf-k6 memory-perf-k8 memory-perf-k10 \
	memory-perf-k12 memory-perf-all memory-stress-small memory-stress-medium \
	memory-stress-large memory-stress-all memory-accuracy-comprehensive \
	memory-compare memory-time-analysis memory-test-complete memory-dev \
	memory-clean help-memory memory-examples

memory: memory-benchmark

memory-benchmark:
	@mkdir -p bin
	go build -o $(BIN) $(BENCHMARK_MEMORY)

# Quick comparison, retained heap by k, and the top k-mers from both counters.
memory-bench-run: memory-benchmark
	./$(BIN) -k 8 -sequences 5000 -length 1000
	./$(BIN) -k 8 -sequences 5000 -length 1000 -memory
	./$(BIN) -k 6 -sequences 1000 -length 1000 -accuracy

memory-analysis: memory-benchmark
	./$(BIN) -k 4 -sequences 10000 -length 500 -verbose
	./$(BIN) -k 8 -sequences 5000 -length 1000 -verbose
	./$(BIN) -k 12 -sequences 100 -length 2000 -verbose

memory-test:
	go test -v $(KMER_PKG) -run 'TestPacked'
	go test -v $(BENCHMARK_MEMORY)

memory-test-race:
	go test -race -v $(KMER_PKG) -run 'TestPacked'
	go test -race $(BENCHMARK_MEMORY)

# The packed counter allocates a 4^k table per sequence, so higher k uses
# fewer sequences.
memory-perf-k4: memory-benchmark
	./$(BIN) -k 4 -sequences 20000 -length 500 -verbose
memory-perf-k6: memory-benchmark
	./$(BIN) -k 6 -sequences 15000 -length 750 -verbose
memory-perf-k8: memory-benchmark
	./$(BIN) -k 8 -sequences 10000 -length 1000 -verbose
memory-perf-k10: memory-benchmark
	./$(BIN) -k 10 -sequences 2000 -length 1500 -verbose
memory-perf-k12: memory-benchmark
	./$(BIN) -k 12 -sequences 100 -length 2000 -verbose

memory-perf-all: memory-perf-k4 memory-perf-k6 memory-perf-k8 memory-perf-k10 memory-perf-k12

memory-stress-small: memory-benchmark
	./$(BIN) -k 6 -sequences 50000 -length 500 -memory -verbose
memory-stress-medium: memory-benchmark
	./$(BIN) -k 8 -sequences 25000 -length 1000 -memory -verbose
memory-stress-large: memory-benchmark
	./$(BIN) -k 10 -sequences 5000 -length 2000 -memory -verbose

memory-stress-all: memory-stress-small memory-stress-medium memory-stress-large

# benchmark_memory exits non-zero if the two counters disagree.
memory-accuracy-comprehensive: memory-benchmark
	@for k in 4 6 8 10 12; do \
		echo "k=$$k"; \
		./$(BIN) -k $$k -sequences 200 -length 1000 -accuracy || exit 1; \
	done

memory-compare: memory-benchmark
	./$(BIN) -k 8 -sequences 5000 -length 1000 -map-only -verbose
	./$(BIN) -k 8 -sequences 5000 -length 1000 -packed-only -verbose
	./$(BIN) -k 8 -sequences 5000 -length 1000 -verbose

memory-time-analysis: memory-benchmark
	@for n in 1000 2000 5000 10000 20000; do \
		echo "sequences=$$n"; \
		./$(BIN) -k 8 -sequences $$n -length 1000 || exit 1; \
	done

memory-test-complete: memory-test memory-test-race memory-accuracy-comprehensive

memory-dev: memory-test memory-bench-run

memory-clean:
	rm -f $(BIN)

help-memory:
	@echo "k-mer counter benchmarks (make -f Makefile.memory <target>):"
	@echo "  memory-benchmark              build $(BIN)"
	@echo "  memory-bench-run              comparison, retained heap by k, top k-mers"
	@echo "  memory-analysis               verbose runs at k=4, 8, 12"
	@echo "  memory-test, memory-test-race packed-array and benchmark tests"
	@echo "  memory-perf-k{4,6,8,10,12}    one k; memory-perf-all runs them all"
	@echo "  memory-stress-{small,medium,large}, memory-stress-all"
	@echo "  memory-accuracy-comprehensive check both counters agree for k=4..12"
	@echo "  memory-compare                hash map only, packed only, both"
	@echo "  memory-time-analysis          k=8 at 1000..20000 sequences"
	@echo "  memory-test-complete          tests plus the accuracy sweep"
	@echo "  memory-dev                    tests plus memory-bench-run"
	@echo "  memory-clean                  remove $(BIN)"
	@echo "  memory-examples               example command lines"

memory-examples:
	@echo "./$(BIN) -k 8 -sequences 5000 -length 1000"
	@echo "./$(BIN) -k 10 -sequences 2000 -length 1000 -memory"
	@echo "./$(BIN) -k 6 -sequences 1000 -length 1000 -accuracy"
	@echo "./$(BIN) -k 8 -sequences 5000 -map-only -verbose"
	@echo "./$(BIN) -k 8 -sequences 5000 -packed-only -verbose -seed 7"
